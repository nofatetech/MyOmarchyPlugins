{
  "schemaVersion": 1,
  "id": "myomarchy.revived-laptop-status",
  "name": "Revived Laptop Status",
  "version": "0.1.0",
  "author": "MyOmarchyPlugins",
  "license": "MIT",
  "description": "Minimal CPU, temperature, fan, and memory health for older laptops",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Revived Laptop Status",
    "description": "Compact CPU load and thermal status with optional fan and memory details",
    "category": "System",
    "aliases": ["revived", "old-laptop", "refurbished", "laptop", "temperature", "fan", "cpu"],
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 3,
      "showFan": true,
      "showMemory": false,
      "temperatureWarningC": 80
    },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 2, "max": 60, "step": 1, "defaultValue": 3 },
      { "key": "showFan", "type": "boolean", "label": "Show fan speed when available", "defaultValue": true },
      { "key": "showMemory", "type": "boolean", "label": "Show memory usage in the bar", "defaultValue": false },
      { "key": "temperatureWarningC", "type": "integer", "label": "Temperature warning (°C)", "min": 60, "max": 100, "step": 1, "defaultValue": 80 }
    ]
  }
}
